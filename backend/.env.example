# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API → Project API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Products → Pro Monthly → Price ID
STRIPE_PRICE_MONTHLY=price_...

# Products → Pro Annual → Price ID
STRIPE_PRICE_ANNUAL=price_...

# Your deployed frontend URL (used for Stripe redirect after checkout)
FRONTEND_URL=http://localhost:5173

# ── Anthropic ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── FMP (optional) ────────────────────────────────────────────────────────────
# financialmodelingprep.com → Dashboard → API Key
# Without this, sector P/E falls back to a static table
FMP_API_KEY=
