# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API → Project API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription — Products → "Subscription" (recurring $14.99/mo) → Price ID
STRIPE_PRICE_SUBSCRIPTION=price_...

# Credit packs — one-time prices. Credit amounts are set in stripe_service.PACKS.
STRIPE_PRICE_STARTER=price_...    # $3.99  → 5 credits
STRIPE_PRICE_STANDARD=price_...   # $9.99  → 15 credits
STRIPE_PRICE_PRO=price_...        # $24.99 → 40 credits

# Custom credits — single $0.99 one-time price, bought with variable quantity
STRIPE_PRICE_CREDIT=price_...     # $0.99 → 1 credit

# Your deployed frontend URL (used for Stripe redirect after checkout)
FRONTEND_URL=http://localhost:5173

# ── Anthropic ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── FMP (optional) ────────────────────────────────────────────────────────────
# financialmodelingprep.com → Dashboard → API Key
# Without this, sector P/E falls back to a static table
FMP_API_KEY=

# ── Finnhub (optional) ────────────────────────────────────────────────────────
# finnhub.io → Dashboard → API Key
# Used for company news. Free tier is sufficient.
FINNHUB_API_KEY=
